# Database Configuration
DB_URL=jdbc:postgresql://postgres:5432/supportticket
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-secret-key-min-32-chars-required-change-this
JWT_EXPIRATION_MS=86400000

# Application Configuration
APP_NAME=Support Ticket Hub
APP_ENVIRONMENT=development
APP_SEED_USERS=john,jane,bob,alice
APP_SEED_USER_PASSWORD=defaultpassword123

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Email (optional)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@supportticket.hub
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=username
SMTP_PASSWORD=password

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis (optional, for caching)
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIRECTORY=/tmp/uploads

# Features
FEATURE_REAL_TIME_UPDATES=true
FEATURE_AUDIT_TRAIL=true
FEATURE_BULK_OPERATIONS=true
