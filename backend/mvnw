if [ -z "$MAVEN_HOME" ] ; then
  MAVEN_HOME="${HOME}/.m2/wrapper"
fi

if [ ! -d "$MAVEN_HOME/maven-3.9.6" ] ; then
  mkdir -p "$MAVEN_HOME"
  cd "$MAVEN_HOME"
  wget -q https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.6/apache-maven-3.9.6-bin.zip
  unzip -q apache-maven-3.9.6-bin.zip
  rm apache-maven-3.9.6-bin.zip
fi

MAVEN_HOME="$MAVEN_HOME/apache-maven-3.9.6"
"$MAVEN_HOME/bin/mvn" "$@"
